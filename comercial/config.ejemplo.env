# Copia este fichero como config.local.env (no se sube al repo) y rellénalo.
# Las variables de entorno con el mismo nombre tienen prioridad.

# Simulación: mientras sea false, NADA se envía de verdad.
VT_LIVE_MODE=false

# Envío (Gmail: smtp.gmail.com, 587 y una contraseña de aplicación)
VT_SMTP_HOST=
VT_SMTP_PORT=587
VT_SMTP_USER=
VT_SMTP_PASSWORD=
VT_FROM_EMAIL=
VT_FROM_NAME=Vanguard Tech
VT_REPLY_TO=

# Firma (vacío = no se muestra; no se inventa nada)
VT_SENDER_NAME=
VT_SENDER_ROLE=
VT_CONTACT_EMAIL=
VT_CONTACT_PHONE=
VT_WEBSITE_URL=
VT_PRIVACY_URL=

# Datos legales: los mismos que pide aviso-legal.html. Sin ellos, las campañas reales quedan bloqueadas.
VT_LEGAL_NAME=
VT_LEGAL_NIF=
VT_LEGAL_ADDRESS=
VT_LEGAL_EMAIL=

# Guardrails
VT_DAILY_LIMIT=15
VT_SEND_INTERVAL_SECONDS=45
VT_TEST_RECIPIENT=
# Puede apuntar al bajas.txt de sistema-de-ventas para compartir la lista de exclusión
VT_EXCLUSION_FILE=
