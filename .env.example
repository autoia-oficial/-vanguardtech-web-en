# ---------------------------------------------------------------------------
# Vanguard CRM — environment
#
# Copy to .env.local for development. Never commit a filled-in copy.
# Anything not set here makes its feature report NOT_CONFIGURED in the app
# rather than failing silently or pretending to work.
# ---------------------------------------------------------------------------

# REQUIRED — PostgreSQL connection string.
# Neon works as-is; use the pooled connection string for serverless.
# The app refuses to start without this rather than falling back to a local
# database, so a misconfigured deployment cannot look healthy while writing
# nowhere useful.
DATABASE_URL=postgresql://user:password@host/vanguard_crm

# Optional. Maximum pooled connections per serverless instance (default 5).
# DATABASE_POOL_MAX=5

# REQUIRED — signs and gates authentication. 32+ random characters.
# Generate with: openssl rand -base64 32
# Without it sign-in is refused and the CRM stays locked.
AUTH_SECRET=

# REQUIRED for scheduled jobs — the bearer token /api/cron/* expects.
# Generate with: openssl rand -hex 32
# There is deliberately no default: if this is unset, every cron route
# rejects every caller.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Email transport — optional
#
# Until all four are set, the queue accepts and holds mail at PENDING and
# sends nothing. No email is ever marked SENT without a provider confirming it.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Lead discovery sources — optional
#
# OpenStreetMap needs no credentials and is always available.
# Google Places is skipped, with a reason, when its key is absent.
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# Optional. Override the Overpass endpoint (defaults to overpass-api.de).
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# ---------------------------------------------------------------------------
# Local development only
# ---------------------------------------------------------------------------

# Used by `npm run seed` to create the first admin account.
SEED_ADMIN_EMAIL=admin@vanguard.invalid
SEED_ADMIN_PASSWORD=change-this-password

# Database the test suite runs against. It is truncated between tests, so it
# must never point at anything you care about.
TEST_DATABASE_URL=postgresql://vanguard:vanguard@127.0.0.1:5432/vanguard_crm_test
